# Cosmos Pay. Use an API key (plugins:read + plugins:write) through the gateway,
# e.g. COSMOS_PAY_URL=https://api.cosmospay.lat/cosmos-api.
COSMOS_PAY_URL=http://127.0.0.1:3000
COSMOS_PAY_API_KEY=

# Local development only, with no API key: a Cosmos Pay server on THIS machine
# with no gateway in front. The gateway secret acts as any consumer with any
# permissions, so the client refuses to send it to a non-loopback address.
# Never put a deployment's gateway secret here.
COSMOS_PAY_GATEWAY_SECRET=
COSMOS_PAY_CONSUMER_USERNAME=
COSMOS_PAY_CONSUMER_PERMISSIONS=plugins:read,plugins:write

# Existing Cosmos Pay intent to link after merchant selection (optional). It must
# pay the selected provider: its destination is the provider's G... address.
COSMOS_PAY_PAYMENT_INTENT_ID=

# Opt-in live Stellar Testnet flow. Never commit funded secrets.
SUB_ROSA_CREATOR_SECRET=
SUB_ROSA_PROVIDER_SECRET=
SUB_ROSA_REVEAL_DELAY_SECONDS=90
SUB_ROSA_RECEIPT_URI=
