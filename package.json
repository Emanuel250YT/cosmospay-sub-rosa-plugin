{
  "name": "cosmospay-sub-rosa-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "External Cosmos Pay plugin and client integration for Sub Rosa private RFQs on Stellar.",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:cosmos": "bash scripts/cosmos-pay-check.sh",
    "test:e2e:cosmos": "bash scripts/cosmos-pay-e2e.sh",
    "test:live": "tsx examples/private-rfq-client/src/live-testnet.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "15.1.0",
    "@sub-rosa/sdk": "0.3.2"
  },
  "overrides": {
    "axios": "1.21.0",
    "minimatch": "11.0.1",
    "toml": "5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "eslint": "^10.14.0",
    "globals": "^16.4.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
